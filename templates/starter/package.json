{
	"name": "nestforge-starter",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"build": "nest build",
		"start": "nest start",
		"start:dev": "nest start --watch",
		"start:prod": "node dist/main.js",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"test:e2e": "vitest run -c vitest.e2e.config.ts",
		"migration:generate": "nest build && typeorm migration:generate -d dist/infrastructure/data-source.js -p",
		"migration:run": "nest build && typeorm migration:run -d dist/infrastructure/data-source.js",
		"migration:revert": "nest build && typeorm migration:revert -d dist/infrastructure/data-source.js"
	},
	"dependencies": {
		"@nestjs/common": "^11.1.3",
		"@nestjs/core": "^11.1.3",
		"@nestjs/jwt": "^11.0.0",
		"@nestjs/passport": "^11.0.5",
		"@nestjs/platform-express": "^11.1.3",
		"@nestjs/swagger": "^12.0.2",
		"@nestjs/terminus": "^11.0.0",
		"@nestjs/throttler": "^6.4.0",
		"@nestjs/typeorm": "^11.0.0",
		"bcrypt": "^6.0.0",
		"dotenv": "^16.5.0",
		"jose": "^5.10.0",
		"nestforge": "workspace:*",
		"passport": "^0.7.0",
		"passport-jwt": "^4.0.1",
		"pg": "^8.11.3",
		"prom-client": "^15.1.3",
		"reflect-metadata": "^0.2.2",
		"rxjs": "^7.8.2",
		"typeorm": "^0.3.20",
		"uuid": "^11.1.0",
		"zod": "^4.1.0"
	},
	"devDependencies": {
		"@nestjs/cli": "^11.0.7",
		"@nestjs/testing": "^11.1.3",
		"@swc/core": "^1.11.0",
		"@types/bcrypt": "^5.0.2",
		"@types/express": "^5.0.3",
		"@types/node": "^22.15.30",
		"@types/passport-jwt": "^4.0.1",
		"@types/supertest": "^7.2.1",
		"supertest": "^7.3.1",
		"typescript": "^5.9.3",
		"unplugin-swc": "^1.5.1",
		"vitest": "^3.2.4"
	}
}
