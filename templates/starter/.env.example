NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://nestjs_user:nestjs_password@localhost:5432/nestjs_postgres
JWT_SECRET=change-me-at-least-32-characters-long
JWT_REFRESH_SECRET=change-me-too-at-least-32-characters
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800
# Google / Apple sign-in (comma-separated client IDs; leave empty to disable)
GOOGLE_CLIENT_IDS=
APPLE_CLIENT_IDS=
