NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://nestjs_user:nestjs_password@localhost:5432/nestjs_postgres
JWT_SECRET=change-me-at-least-32-characters-long
JWT_REFRESH_SECRET=change-me-too-at-least-32-characters
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800
# Google / Apple sign-in (comma-separated client IDs; leave empty to disable)
GOOGLE_CLIENT_IDS=
APPLE_CLIENT_IDS=
# OAuth authorization-code flows (see README "Social sign-in"). The first ID in *_CLIENT_IDS is the web client.
GOOGLE_CLIENT_SECRET=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# Contents of the Sign in with Apple .p8 key; a literal \n between lines is fine on one line
APPLE_PRIVATE_KEY=
# Public URL of this API (provider redirect URIs are <this>/api/auth/<provider>/callback)
OAUTH_PUBLIC_URL=
# Frontend page that receives ?code=... (or ?error=...) after the redirect flow
WEB_LOGIN_REDIRECT_URL=
# Bearer token required for GET /metrics (16+ chars; empty = open)
METRICS_TOKEN=
# TLS to Postgres (default: on in production, off otherwise)
DATABASE_SSL=
# Swagger UI at /docs (default: on outside production)
SWAGGER_ENABLED=
