{
	"name": "nestforge",
	"version": "0.2.0",
	"description": "Reusable Either / value-object / query-filter core for NestJS apps. ORM-agnostic, Zod-based.",
	"license": "UNLICENSED",
	"main": "./dist/index.js",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.mjs",
			"require": "./dist/index.js"
		}
	},
	"files": ["dist"],
	"scripts": {
		"build": "tsup",
		"prepare": "tsup",
		"dev": "tsup --watch",
		"test": "vitest run",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"shallow-equal-object": "^1.1.1",
		"uuid": "^11.1.0",
		"zod": "^4.1.0"
	},
	"peerDependencies": {
		"@nestjs/common": ">=10",
		"@nestjs/core": ">=10",
		"rxjs": ">=7"
	},
	"devDependencies": {
		"@nestjs/common": "^11.1.3",
		"@nestjs/core": "^11.1.3",
		"@types/express": "^5.0.3",
		"@types/node": "^22.15.30",
		"reflect-metadata": "^0.2.2",
		"rxjs": "^7.8.2",
		"tsup": "^8.3.5",
		"typescript": "^5.9.3",
		"vitest": "^3.2.4"
	}
}
